# Kopiere diese Datei nach ".env" und trage die Werte aus Supabase ein
# (Project Settings -> API). Nur den "anon"/publishable Schlüssel verwenden, nie den service_role-Schlüssel.
SUPABASE_URL=https://DEINE-PROJEKT-ID.supabase.co
SUPABASE_ANON_KEY=dein-anon-key
# Adresse der veröffentlichten App (GitHub Pages) für CORS: nur der Origin, ohne Pfad und ohne "/" am Ende.
APP_ORIGIN=https://DEIN-GITHUB-NAME.github.io
# Optional: Port der Werkstatt
# PORT=5174
